{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api?route=/api/v1/:path*" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/v1/cron/maintenance", "schedule": "0 19 * * *" }]
}
