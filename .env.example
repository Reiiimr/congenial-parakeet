# Supabase transaction-pooler connection string for the restricted ekapon_api role (or a local PostgreSQL URL).
DATABASE_URL=postgres://ekapon_api:CHANGE_ME@127.0.0.1:5432/ekapon

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Vercel Cron sends this as "Authorization: Bearer <value>" to /api/v1/cron/maintenance. Generate it the same way.
CRON_SECRET=replace-this-with-another-random-secret

NODE_ENV=development
SESSION_HOURS=8
LOGIN_IP_MAX_FAILURES=20
ALLOWED_ORIGINS=
